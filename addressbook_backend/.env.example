# Copy to .env and fill with your real values. Never commit the real .env.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# From your Render PostgreSQL instance (External Database URL fields)
DB_NAME=your_render_db_name
DB_USER=your_render_db_user
DB_PASSWORD=your_render_db_password
DB_HOST=your_render_db_host.render.com
DB_PORT=5432

# --- Rate limiter ---
# Shared cache so limits work across gunicorn workers (Render Key Value / Redis URL).
REDIS_URL=
RATE_LIMIT_ENABLED=True
# Reverse proxies in front of Django (Render = 1; Render behind Cloudflare = 2)
RATE_LIMIT_TRUSTED_PROXIES=1
RATE_LIMIT_ALLOWLIST=
RATE_LIMIT_BLOCKLIST=

# --- Backups ---
# "s3" is strongly recommended on Render (the local disk is wiped on every deploy).
BACKUP_STORAGE=local
BACKUP_LOCAL_DIR=backups_data
BACKUP_INTERVAL_MINUTES=30
# keep every backup of the last 48 h, then the newest of each day for 35 days
BACKUP_KEEP_RECENT_HOURS=48
BACKUP_KEEP_DAILY_DAYS=35
# Monthly automatic restore (loads the newest backup into the DB). Runs on day 27 at 12:00 (Asia/Tehran).
BACKUP_RESTORE_ENABLED=True
# Day of the Gregorian month; time is Asia/Tehran.
BACKUP_RESTORE_DAY=27
BACKUP_RESTORE_TIME=12:00
# Only if you use an external cron instead of a Background Worker (see README):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKUP_CRON_TOKEN=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=addressbook-backups/
BACKUP_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
